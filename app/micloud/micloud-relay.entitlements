<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "pro edition" / relay build (Developer ID, NOT App Store): the store entitlements plus read-only
     sandbox exceptions for the other-app stores the production lanes read (Calendar.sqlitedb only for the
     exception dates EventKit withholds). TCC still gates them:
     grant micloud.app Full Disk Access once (System Settings → Privacy & Security). -->
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.personal-information.photos-library</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.personal-information.calendars</key><true/>
  <key>com.apple.security.personal-information.addressbook</key><true/>
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
  <array>
    <string>/Library/Safari/</string>
    <string>/Library/Group Containers/group.com.apple.notes/</string>
    <string>/Library/Group Containers/group.com.apple.calendar/</string>
    <string>/Library/Messages/</string>
    <string>/Library/Mail/</string>
    <string>/Library/Mobile Documents/</string>
  </array>
</dict></plist>
