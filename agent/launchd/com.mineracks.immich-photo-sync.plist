<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mineracks.immich-photo-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/USERNAME/bin/immich-photo-sync.sh</string>
    </array>

    <!-- Trigger when Photos Library originals directory changes -->
    <key>WatchPaths</key>
    <array>
        <string>/Volumes/PhotosSSD/Photos Library.photoslibrary/originals</string>
    </array>

    <!-- Also run every hour as a safety net -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Throttle: dont re-trigger within 30 seconds of last run -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/immich-sync-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/immich-sync-launchd.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
