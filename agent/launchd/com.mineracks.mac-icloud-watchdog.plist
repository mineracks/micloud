<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mineracks.mac-icloud-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/Library/Scripts/mac-icloud-watchdog.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/Library/Logs/mac-icloud-watchdog.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/Library/Logs/mac-icloud-watchdog.err.log</string>
</dict>
</plist>
