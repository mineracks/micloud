# micloud agent configuration — the single source of per-instance settings.
#
# Copy to  ~/.config/micloud/config.env  and fill in for this instance, then the agent scripts
# and daemons read it (shell: `set -a; . config.env; set +a`; Python: the micloud_config loader).
# This is what makes the agent reproducible + multi-tenant: nothing below is hardcoded in code.
#
# Values may reference $HOME. Keep this file mode 600 (it can hold endpoints, not raw passwords —
# credentials live in the rclone config + immich auth.yml + the DAV/mail env files).

# ── Identity & monitoring ────────────────────────────────────────────────────
MICLOUD_INSTANCE="default"                                 # instance id → Loki label (multi-tenant fleet)
MICLOUD_HOST_LABEL="default"                               # Loki `host` label for this box
MICLOUD_LOKI_URL="http://LOKI_HOST:3100/loki/api/v1/push"  # blank ("") to disable heartbeats entirely

# ── Tool paths ───────────────────────────────────────────────────────────────
MICLOUD_PYTHON="/usr/bin/python3"                          # MUST have PyObjC + FSEvents (system python does)
MICLOUD_RCLONE="/opt/homebrew/bin/rclone"
MICLOUD_OSXPHOTOS="/opt/homebrew/bin/osxphotos"
MICLOUD_IMMICH="/opt/homebrew/bin/immich"

# ── Sovereign targets (rclone remotes must already be configured on this Mac) ──
MICLOUD_NC_REMOTE="nextcloud"                              # rclone remote for Drive/Documents/DAV
MICLOUD_NC_PHOTOS_REMOTE="nextcloud-photos"                # rclone remote for Photos
MICLOUD_NC_PHOTOS_PATH="Photos/iCloud-Camera"              # NC folder the Nextcloud Photos app indexes
MICLOUD_NC_DOCUMENTS="Documents"                           # NC path (under MICLOUD_NC_REMOTE) for Documents
MICLOUD_NC_TRASH="nextcloud:.trash/deltasync"              # soft-delete destination (<remote>:.trash/deltasync)

# ── Photos component ─────────────────────────────────────────────────────────
MICLOUD_PHOTOS_ENABLED="true"
MICLOUD_PHOTOS_LIBRARY="$HOME/Pictures/Photos Library.photoslibrary"
MICLOUD_PHOTOS_TO_IMMICH="true"
MICLOUD_PHOTOS_TO_NEXTCLOUD="true"
MICLOUD_PHOTOS_BUFFER_DAYS="2"                             # hourly-equiv look-back; the mop-up passes a large value

# ── Documents / Drive component ──────────────────────────────────────────────
MICLOUD_DOCUMENTS_ENABLED="true"
MICLOUD_DOCUMENTS_SRC="$HOME/Documents"

# ── Other components (their own env files hold credentials) ──────────────────
#   Calendars/Contacts (DAV)  → agent/dav/  (icloud-dav env file)
#   Mail                      → server-side mail-mirror (mbsync)
#   Reminders/Notes/Bookmarks → agent/scripts/bin/  (WatchPaths daemons)
# Enable/disable here as the components are generalised:
MICLOUD_DAV_ENABLED="false"
MICLOUD_REMINDERS_ENABLED="false"
MICLOUD_NOTES_ENABLED="false"
MICLOUD_BOOKMARKS_ENABLED="false"
